{
  "info": {
    "name": "LeaseSpaces Auth (Admin, Tenant, Landlord)",
    "description": "Test auth flows for admin, tenant, and customer/landlord. Set baseUrl and (after sync) backendToken in collection or environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "firebaseIdToken", "value": "" },
    { "key": "backendToken", "value": "" },
    { "key": "otpEmail", "value": "tenant@example.com" },
    { "key": "otpCode", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "conversationId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get Firebase ID token (run from Postman)",
      "item": [
        {
          "name": "A. Sign up (create user) → get idToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant@example.com\",\n  \"password\": \"password123\",\n  \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=YOUR_FIREBASE_WEB_API_KEY",
            "description": "Creates a new Firebase user from Postman. Replace YOUR_FIREBASE_WEB_API_KEY in URL (Firebase Console → Project settings → General → Web API Key). Use a new email each time or you'll get EMAIL_EXISTS. Response contains 'idToken' → copy it into collection variable firebaseIdToken."
          }
        },
        {
          "name": "B. Sign in (existing user) → get idToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant@example.com\",\n  \"password\": \"password123\",\n  \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=YOUR_FIREBASE_WEB_API_KEY",
            "description": "Use for users already created (by A or in Firebase Console). Replace YOUR_FIREBASE_WEB_API_KEY. Copy 'idToken' from response into variable firebaseIdToken."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health - GET /api/auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth",
            "description": "No auth. Confirms auth API is up."
          }
        },
        {
          "name": "Sync - POST /api/auth/sync (Firebase token → backend JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{firebaseIdToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/sync",
            "description": "Use Firebase ID token in Authorization. Copy returned 'token' into backendToken. Works for tenant, landlord, and admin (role comes from DB appRole)."
          }
        },
        {
          "name": "OTP Request - POST /api/auth/otp/request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otpEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/otp/request",
            "description": "Requests a 6-digit OTP for the email. OTP is valid for 5 minutes and delivered through configured SMTP."
          }
        },
        {
          "name": "OTP Verify - POST /api/auth/otp/verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otpEmail}}\",\n  \"otp\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/otp/verify",
            "description": "Verifies OTP and returns backend JWT with role and onboardingRequired flag. Copy token to backendToken."
          }
        },
        {
          "name": "Manual Onboarding - POST /api/auth/onboarding",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"surname\": \"User\",\n  \"role\": \"tenant\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/onboarding",
            "description": "Complete first-time onboarding when otp verify returns onboardingRequired: true."
          }
        },
        {
          "name": "Firebase - POST /api/auth/firebase (body)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{firebaseIdToken}}\",\n  \"registrationType\": \"GOOGLE\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/firebase",
            "description": "Same as sync but idToken in body. registrationType: GOOGLE | FACEBOOK | APPLE | EMAIL."
          }
        }
      ]
    },
    {
      "name": "Tenant",
      "item": [
        {
          "name": "GET /api/applications (tenant)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/applications",
            "description": "Requires backend JWT from sync (tenant or any authenticated user)."
          }
        },
        {
          "name": "POST /api/applications (tenant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"<property-uuid>\",\n  \"moveInDate\": \"2025-02-01\",\n  \"message\": \"Interested in this property\"\n}"
            },
            "url": "{{baseUrl}}/api/applications",
            "description": "Create application. Replace propertyId with a real property ID."
          }
        }
      ]
    },
    {
      "name": "Landlord / Customer",
      "item": [
        {
          "name": "GET /api/properties (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/properties",
            "description": "Public. No auth."
          }
        },
        {
          "name": "POST /api/properties (landlord)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Property\",\n  \"description\": \"Description\",\n  \"price\": 15000,\n  \"propertyType\": \"apartment\",\n  \"rentalType\": \"long-term\",\n  \"bedrooms\": 2,\n  \"bathrooms\": 2,\n  \"location\": { \"address\": \"123 Main St\", \"city\": \"Johannesburg\", \"province\": \"Gauteng\" }\n}"
            },
            "url": "{{baseUrl}}/api/properties",
            "description": "Create property. Requires backend JWT (landlord or admin)."
          }
        }
      ]
    },
    {
      "name": "Admin (LeaseSpaces)",
      "item": [
        {
          "name": "GET /api/admin/dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/dashboard",
            "description": "Requires user with appRole admin. Use token from /api/auth/sync with an admin user."
          }
        },
        {
          "name": "GET /api/admin/properties/analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/properties/analytics?period=30d",
            "description": "Query: period=7d|30d|90d|1y"
          }
        },
        {
          "name": "GET /api/admin/admin-profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/admin-profile"
          }
        },
        {
          "name": "GET /api/admin/settings/about",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/about",
            "description": "Get About page content for admin settings."
          }
        },
        {
          "name": "POST /api/admin/settings/about",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"About page content goes here.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/about",
            "description": "Save About page content."
          }
        },
        {
          "name": "PUT /api/admin/settings/about",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated About page content.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/about",
            "description": "Update About page content."
          }
        },
        {
          "name": "DELETE /api/admin/settings/about",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/about",
            "description": "Delete About page content."
          }
        },
        {
          "name": "GET /api/admin/settings/privacy-policy",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/privacy-policy",
            "description": "Get Privacy Policy content for admin settings."
          }
        },
        {
          "name": "POST /api/admin/settings/privacy-policy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Privacy policy content goes here.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/privacy-policy",
            "description": "Save Privacy Policy content."
          }
        },
        {
          "name": "PUT /api/admin/settings/privacy-policy",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated Privacy Policy content.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/privacy-policy",
            "description": "Update Privacy Policy content."
          }
        },
        {
          "name": "DELETE /api/admin/settings/privacy-policy",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/privacy-policy",
            "description": "Delete Privacy Policy content."
          }
        },
        {
          "name": "GET /api/admin/settings/terms-and-conditions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/terms-and-conditions",
            "description": "Get Terms & Conditions content for admin settings."
          }
        },
        {
          "name": "POST /api/admin/settings/terms-and-conditions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Terms & Conditions content goes here.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/terms-and-conditions",
            "description": "Save Terms & Conditions content."
          }
        },
        {
          "name": "PUT /api/admin/settings/terms-and-conditions",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated Terms & Conditions content.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/settings/terms-and-conditions",
            "description": "Update Terms & Conditions content."
          }
        },
        {
          "name": "DELETE /api/admin/settings/terms-and-conditions",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/settings/terms-and-conditions",
            "description": "Delete Terms & Conditions content."
          }
        },
        {
          "name": "POST /api/admin/users/admins",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John\",\n  \"surname\": \"Doe\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"securepassword123\",\n  \"isSuperAdmin\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/users/admins",
            "description": "Create admin user. Requires super admin."
          }
        },
        {
          "name": "POST /api/admin/users/:userId/2fa/init",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/users/123/2fa/init",
            "description": "Super admin: generate secret + qrCodeBase64 for user."
          }
        },
        {
          "name": "POST /api/admin/users/:userId/2fa/enable",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"JBSWY3DPEHPK3PXP\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/users/123/2fa/enable",
            "description": "Super admin: enable 2FA after OTP. Body: secret from init + 6-digit otp."
          }
        },
        {
          "name": "POST /api/admin/users/:userId/2fa/disable",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/users/123/2fa/disable",
            "description": "Disable 2FA for a user. Replace :userId with actual user ID."
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "POST /api/properties/:propertyId/chats (tenant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{backendToken}}" }],
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/chats",
            "description": "Message landlord. Set propertyId from GET /api/properties. Copy conversation.id to conversationId."
          }
        },
        {
          "name": "GET /api/chats (inbox)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{backendToken}}" }],
            "url": "{{baseUrl}}/api/chats?limit=20",
            "description": "List conversations for current user."
          }
        },
        {
          "name": "GET /api/chats/:conversationId/history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{backendToken}}" }],
            "url": "{{baseUrl}}/api/chats/{{conversationId}}/history?limit=50&order=asc",
            "description": "Chat history with sentAt/createdAt timestamps."
          }
        },
        {
          "name": "POST /api/chats/:conversationId/messages",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{backendToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Hello from Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/chats/{{conversationId}}/messages",
            "description": "Send a chat message."
          }
        },
        {
          "name": "POST /api/chats/:conversationId/read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{backendToken}}" }],
            "url": "{{baseUrl}}/api/chats/{{conversationId}}/read",
            "description": "Mark messages from other party as read."
          }
        }
      ]
    },
    {
      "name": "Support (public)",
      "item": [
        {
          "name": "GET /api/support/form",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/support/form",
            "description": "Categories for Create support ticket UI. No auth."
          }
        },
        {
          "name": "POST /api/support/tickets",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Account & Login\",\n  \"description\": \"I cannot reset my password after multiple attempts.\",\n  \"customerEmail\": \"support-test@example.com\",\n  \"confirmEmail\": \"support-test@example.com\",\n  \"customerName\": \"Test User\"\n}"
            },
            "url": "{{baseUrl}}/api/support/tickets",
            "description": "Create public support ticket. Confirmation email is sent to customerEmail (the submitter), not to support staff. Returns ticketNumber, emailSent, confirmationEmailSentTo."
          }
        }
      ]
    },
    {
      "name": "Legacy Admin (Firestore)",
      "item": [
        {
          "name": "POST /api/admin/admin-login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/admin-login",
            "description": "Email/password against Firestore 'admins' collection. Returns backend JWT. Use for legacy admin routes only."
          }
        }
      ]
    }
  ]
}
